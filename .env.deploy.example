# 复制为仓库根的 .env.deploy 后填写。该文件不得提交到 Git。
# YuePC（YPC）常见私钥：C:\Users\Administrator\.ssh\id_ed25519
# MSI 常见私钥：C:\Users\win10\.ssh\id_ed25519

DEPLOY_SSH_HOST=124.221.56.38
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22
DEPLOY_SSH_KEY=

# 静态网站根（必须与现网一致）
DEPLOY_REMOTE_WEB_ROOT=/www/wwwroot/124.221.56.38

# 应用代码根与虚拟环境（应用编程接口模式）
DEPLOY_REMOTE_APP_ROOT=/opt/football-analyze-tool
DEPLOY_REMOTE_VENV=/opt/football-analyze-tool/.venv
DEPLOY_SYSTEMD_UNIT=football-analyze-api

# 正式库（正式库模式）。路径不要写进脚本，只填在本机这个文件里。
# MSI 常见：D:\Du_Test\football\current\app_latest.db
# YuePC 请填这台电脑上的正式库绝对路径。文件名必须是 app_latest.db。
DEPLOY_DB_LOCAL_PATH=
DEPLOY_REMOTE_DB_PATH=/opt/football-data/app_latest.db
DEPLOY_REMOTE_DB_BACKUP_DIR=/opt/football-data/backups

# 默认模式：static,api   可选再加 db。也可用 --modes 覆盖。
DEPLOY_MODES=static,api

# 可选：Nginx 重载命令。留空则自动探测 nginx 或宝塔路径。
# 只允许这种形式：绝对路径 -t && 绝对路径 -s reload
# DEPLOY_NGINX_CMD=/www/server/nginx/sbin/nginx -t && /www/server/nginx/sbin/nginx -s reload
