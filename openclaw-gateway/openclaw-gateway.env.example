# 复制为本目录下的 openclaw-gateway.env 后只在本机使用。该文件名已被 .gitignore 排除。
# 生产环境的正式文件放在服务器 /opt/football-data/openclaw-gateway.env，权限设为 600，属主为运行用户 football。
# 本服务只读取进程环境变量，不会自动加载仓库根目录的 .env。

# 监听地址只允许 127.0.0.1、localhost 或 ::1。不要填写 0.0.0.0。
GATEWAY_BIND=127.0.0.1

# 监听端口。不要填写 8787，该端口保留给现有的 football-analyze-api。
GATEWAY_PORT=8790

# 0 表示健康检查不要求 Bearer 令牌。改为 1 后，GET /v1/health 与其它接口一样校验令牌。
GATEWAY_REQUIRE_AUTH_ON_HEALTH=0

# 入站 Bearer 令牌。留空时，除按上面开关放行的健康检查外，其余接口一律返回 401。
# 生产令牌请用密码学随机数生成，至少 32 字节，不要写进 Git，也不要复用其它数据源的密钥。
OPENCLAW_BEARER_TOKEN=

# 上游只读分析接口固定为 http://127.0.0.1:8787，不能改成其它主机。
# 连接与读取超时（秒）。默认 3。大于 10 时按 10 执行。无法识别时回到 3。
OPENCLAW_UPSTREAM_TIMEOUT_SECONDS=3

# 单次上游响应体上限（字节）。默认 1048576，且不允许提高。
OPENCLAW_UPSTREAM_MAX_BYTES=1048576

# 任务库 SQLite 文件。不进 Git。单测必须改到临时路径，不要写到仓库目录。
OPENCLAW_JOB_DB_PATH=/opt/football-data/openclaw-jobs.sqlite3

# 单次任务最长执行秒数。默认 10。大于 30 时按 30 执行。
OPENCLAW_JOB_MAX_SECONDS=10

# 创建请求处理超时秒数。默认 5。超时返回 504。大于 10 时按 10 执行。
OPENCLAW_JOB_CREATE_TIMEOUT_SECONDS=5

# 成功与失败任务的保留秒数。默认 86400（24 小时）。0 表示终态任务在下次访问时立即过期。
OPENCLAW_JOB_RETENTION_SECONDS=86400
