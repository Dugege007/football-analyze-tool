# 这个文件只说明键名。不要把它提交成填好的配置，cron 也不会 source 仓库里的副本。
# 真正的配置放在仓库外，用 AUTO_CN_PUSH_ENV 指向它。循环和看门狗都读那一个文件。
# 缺少 APP_DB_PATH 或文件不存在时，脚本会告警并退出，不会改用代码里的默认库。

APP_DB_PATH=
ODDS_DATA_DIR=

# 打包循环、标记和 staging 的目录。不设置时就是脚本所在目录。
# 现网循环目录仍是 /workspace/football-analyze-tool-ops/auto-cn-push-after-close-20261020
AUTO_CN_PUSH_HOME=

# 下面两个名字来自附件里的脱敏副本，不是现网 push 脚本原来读取的变量。
# 现网 YuePC/MSI 脚本把密钥路径和 SSH 目标写在参数默认值里，并不读这两个变量。
# 不要把现网的值写进本文件后再提交。迁移见同目录 README.md。
FAT_CN_SSH_KEY=
FAT_CN_SSH_TARGET=

# 生产激活和回滚钩子。事务要求两者都存在。钩子要重启服务，并打印
# {"ok": true, "db_sha256": "<正在提供的库指纹>", "read_only": true}
# 不要把 FAT_CN_ALLOW_TEST_LOCAL 写进生产配置。没有 SSH 目标时，推送会失败。
FAT_CN_ACTIVATE_CMD=
FAT_CN_ROLLBACK_CMD=

# 投放目录。不设置时，脚本仍用现网 YuePC / MSI 投放目录。
AUTO_CN_PUSH_YPC_DROP=
AUTO_CN_PUSH_MSI_DROP=

# 没有已推标记时的回看天数。已有标记时从连续已推边界的次日扫到今天，不受此值限制。
AUTO_CN_PUSH_LOOKBACK_DAYS=14
AUTO_CN_PUSH_HEARTBEAT_STALE_SEC=900
AUTO_CN_PUSH_LONG_OP_MAX_SEC=3600
AUTO_CN_PUSH_INTERVAL_SEC=300
